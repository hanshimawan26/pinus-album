---
/**
 * Album page for any node at any depth (TRD §5, §6.3): breadcrumbs, title and date, story,
 * section cards, the node's own photo grid, sibling navigation.
 */
import { getEntry, render } from 'astro:content';
import AlbumCardList from '../../components/AlbumCardList.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import NodeMeta from '../../components/NodeMeta.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import SiblingNav from '../../components/SiblingNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadAlbumsOrThrow, pathTo, siblingsOf, slugPathKey } from '../../lib/content/index.ts';
import { startsNearTop } from '../../lib/image-sizes.ts';
import { markdownToPlainText, nodeDescription } from '../../lib/presentation.ts';
import { viewerContext } from '../../lib/viewer-data.ts';

export async function getStaticPaths() {
  const albums = await loadAlbumsOrThrow({ includeDrafts: import.meta.env.DEV });
  return [...albums.nodes.values()]
    .filter((node) => node.depth > 0)
    .map((node) => ({ params: { path: node.slugPath.join('/') }, props: { key: slugPathKey(node.slugPath) } }));
}

interface Props {
  key: string;
}

// Look the node up again rather than passing it as a prop, so `astro dev` shows fresh
// content after a file changes (loadAlbums is memoised and rebuilds only on change).
const { key } = Astro.props;
const albums = await loadAlbumsOrThrow({ includeDrafts: import.meta.env.DEV });
const node = albums.nodes.get(key);
if (!node) {
  throw new Error(`The album "${key}" no longer exists. Reload the home page.`);
}

const trail = pathTo(albums.root, node.slugPath) ?? [node];
const { previous, next } = siblingsOf(albums.root, node.slugPath);
const storyEntry = node.story ? await getEntry('stories', key) : undefined;
const Story = storyEntry ? (await render(storyEntry)).Content : undefined;

// Cards and photos load eagerly only when they start in the first viewport: a story of a
// few paragraphs pushes them below the fold on a phone (TRD §6.4).
const contentNearTop = startsNearTop(node.story ? markdownToPlainText(node.story).length : 0);
const hasSections = node.children.length > 0;
const hasPhotos = node.photos.length > 0;
---

<BaseLayout title={node.title} description={nodeDescription(node)}>
  <div class="container page">
    <Breadcrumbs trail={trail} />

    <header class="album-header">
      <h1 class="page-title">
        {node.title}
        {node.draft && <DraftBadge />}
      </h1>
      <NodeMeta node={node} size="page" />
    </header>

    {
      Story && (
        <div class="story">
          <Story />
        </div>
      )
    }

    {
      hasSections && (
        <section class="block" aria-labelledby="sections-heading">
          <h2 id="sections-heading" class="block-heading">
            Sections
          </h2>
          <AlbumCardList nodes={node.children} size="section" headingLevel={3} nearTop={contentNearTop} />
        </section>
      )
    }

    {
      hasPhotos && (
        <section class="block" aria-labelledby="photos-heading">
          <h2 id="photos-heading" class:list={['block-heading', { 'visually-hidden': !hasSections }]}>
            Photos
          </h2>
          <PhotoGrid photos={node.photos} context={viewerContext(trail.map((item) => item.title))} nearTop={contentNearTop && !hasSections} />
        </section>
      )
    }

    {
      !hasSections && !hasPhotos && (
        <div class="block">
          <EmptyState title="No photos here yet">
            <p>This album is still empty. Photos usually appear a few days after the event.</p>
          </EmptyState>
        </div>
      )
    }

    <SiblingNav previous={previous} next={next} kind={node.depth === 1 ? 'events' : 'sections'} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-5);
  }

  .album-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .story {
    max-width: var(--prose-max);
    margin-top: var(--space-5);
  }

  .story :global(> * + *) {
    margin-top: var(--space-4);
  }

  .story :global(:is(h2, h3, h4)) {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
  }

  .story :global(:is(ul, ol)) {
    padding-inline-start: 1.25em;
  }

  .story :global(code) {
    padding: 0.05em 0.25em;
    border-radius: 4px;
    background: var(--color-surface-sunken);
    font-size: 0.9em;
  }

  .story :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .block {
    margin-top: var(--space-7);
  }

  .block-heading {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  /* A grid without a visible heading sits closer to the header. */
  .block:has(> .visually-hidden:first-child) {
    margin-top: var(--space-6);
  }

  @media (min-width: 900px) {
    .page {
      padding-top: var(--space-6);
    }
  }
</style>
