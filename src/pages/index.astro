---
/** Home (TRD §6.2): every event, newest first. */
import AlbumCardList from '../components/AlbumCardList.astro';
import EmptyState from '../components/EmptyState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAlbumsOrThrow, siteLoadOptions } from '../lib/content/index.ts';
import { previewImageFor } from '../lib/images.ts';
import { countLabel } from '../lib/presentation.ts';

const albums = await loadAlbumsOrThrow(siteLoadOptions(import.meta.env.DEV));
const events = albums.root.children;
// The link preview shows the newest event's cover.
const previewImage = await previewImageFor(albums.root.cover);
---

<BaseLayout isHome previewImage={previewImage}>
  <div class="container page">
    <header class="intro">
      <h1 class="page-title">Photo albums</h1>
      {
        events.length > 0 && (
          <p class="meta">
            <span>{countLabel(events.length, 'event')}</span>
            {albums.root.photoCount > 0 && <span>{countLabel(albums.root.photoCount, 'photo')}</span>}
          </p>
        )
      }
    </header>

    {
      events.length > 0 ? (
        <AlbumCardList nodes={events} size="event" headingLevel={2} nearTop />
      ) : (
        <EmptyState title="No albums yet">
          <p>Photos from our events will appear here soon. Check back after the next event.</p>
        </EmptyState>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-6);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 900px) {
    .page {
      padding-top: var(--space-7);
    }
    .intro {
      margin-bottom: var(--space-7);
    }
  }
</style>
