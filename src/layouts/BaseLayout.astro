---
/**
 * Page shell: document head (title, description, robots, link preview), skip link and the
 * landmarks header › main › footer (TRD §6.1, §6.6). The global stylesheet is imported once,
 * here.
 *
 * Link preview (Open Graph and X card tags): what WhatsApp, Telegram, Instagram DMs and
 * social sites show for a shared link. The page's title and description, and its album
 * cover as a large image when the page has one (images.ts `previewImageFor`). Every URL is
 * absolute, from the site's address (`SITE_URL`). The 404 page has none: it is served at any
 * unknown address, so it has no address of its own to share.
 */
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { ALLOW_INDEXING, SITE, THEME_COLOR } from '../lib/config.ts';
import type { SizedImage } from '../lib/images.ts';
import { withBase } from '../lib/url.ts';

interface Props {
  /** Page-specific title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Marks the header's home link as the current page. */
  isHome?: boolean;
  /** The link preview image (an album cover), with its alt text. */
  previewImage?: SizedImage & { alt: string } | undefined;
  /** False on the 404 page: no link preview tags. */
  linkPreview?: boolean;
}

const {
  title,
  description = `Photo albums of ${SITE.name}, ${SITE.descriptor}.`,
  isHome = false,
  previewImage,
  linkPreview = true,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const absolute = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={ALLOW_INDEXING ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {
      linkPreview && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={SITE.name} />
          <meta property="og:title" content={title ?? SITE.name} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={absolute(Astro.url.pathname)} />
          {previewImage && (
            <>
              <meta property="og:image" content={absolute(previewImage.src)} />
              <meta property="og:image:type" content="image/jpeg" />
              <meta property="og:image:width" content={String(previewImage.width)} />
              <meta property="og:image:height" content={String(previewImage.height)} />
              <meta property="og:image:alt" content={previewImage.alt} />
            </>
          )}
          <meta name="twitter:card" content={previewImage ? 'summary_large_image' : 'summary'} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader isHome={isHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--brand-blue);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    display: block;
    padding-bottom: var(--space-8);
  }

  main:focus {
    outline: none;
  }
</style>
