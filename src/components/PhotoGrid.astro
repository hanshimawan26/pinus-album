---
/**
 * Justified photo grid (TRD §6.4): whole photos in rows that each fill the grid's width, with
 * 3px gaps. The rows come from justified-grid.ts, for phones, from 600px and from 1100px. Each
 * tile reserves its space from the photo's aspect ratio, so nothing shifts while images load.
 * Each tile is a button named by the photo's alt text.
 *
 * The post viewer (PostViewer.astro, TRD §6.5) reads the JSON below: `photos[i]` belongs to
 * the tile with `data-index="i"`; its `slug` is the deep-link hash (TRD §4.7).
 * Rendering the viewer here means its script ships only on pages that have photos.
 *
 * With two or more credited photographers, filter chips sit above the grid (TRD §6.3 item 8);
 * each tile carries its photographer's slug as `data-photographer` for them.
 *
 * Each tile also has a check circle for selecting several photos to download (TRD §6.4.1). It
 * is a sibling of the tile, as a button cannot hold a button, and needs the script: the circles
 * exist on screen only once `src/scripts/selection/` has set `data-selectable` on the grid.
 */
import { loadingHint, thumbnailSizes } from '../lib/image-sizes.ts';
import CheckIcon from './CheckIcon.astro';
import PhotographerFilter from './PhotographerFilter.astro';
import PostViewer from './PostViewer.astro';
import SelectionBar from './SelectionBar.astro';
import { downloadImageFor, thumbnailFor, viewerImageFor } from '../lib/images.ts';
import { aspectOf, tileShares, tileStyle } from '../lib/justified-grid.ts';
import { photographerChips } from '../lib/photographer-filter.ts';
import { jsonForScript } from '../lib/presentation.ts';
import { archiveFileName, downloadFileName, viewerPhoto, type GridPhoto, type ViewerData } from '../lib/viewer-data.ts';

interface Props {
  /** In display order, with each photo's deep-link slug on this page. */
  photos: readonly GridPhoto[];
  /** "Day 1 · Demo Event A", shown in the viewer's details panel. */
  context: string;
  /** The album's slug path (`['pinus-ori', 'day-1']`): the start of each download's file name. */
  albumPath: readonly string[];
  /** True when the grid starts in the first viewport, so the first row loads eagerly. */
  nearTop: boolean;
}

const { photos, context, albumPath, nearTop } = Astro.props;
const aspects = photos.map(({ photo }) => aspectOf(photo.width, photo.height));
const shares = tileShares(aspects);
const tiles = await Promise.all(
  photos.map(async ({ photo, ...placement }, index) => ({
    photo,
    placement,
    style: tileStyle(aspects[index]!, shares[index]!),
    thumbnail: await thumbnailFor(photo, thumbnailSizes(shares[index]!)),
    viewer: await viewerImageFor(photo),
    download: { ...(await downloadImageFor(photo)), fileName: downloadFileName(albumPath, placement.slug) },
  })),
);
const viewerData: ViewerData = {
  context,
  archiveName: archiveFileName(albumPath),
  photos: tiles.map(({ photo, placement, viewer, download }) => viewerPhoto(photo, viewer, download, placement)),
};
const chips = photographerChips(photos.map(({ photo }) => photo));
// The first few tiles (about a row on the widest layout, two on a phone) load eagerly with
// high priority: any of them can be the largest contentful paint.
const policy = { nearTop, highPriority: 5, eager: 5 };
---

{chips.length > 0 && <PhotographerFilter chips={chips} total={photos.length} />}
<ul class="bare-list grid" role="list" data-photo-grid>
  {
    tiles.map(({ photo, style, thumbnail }, index) => {
      const hint = loadingHint(index, policy);
      return (
        <li style={style}>
          <button type="button" class="tile" aria-haspopup="dialog" data-index={index} data-photographer={photo.photographer?.slug}>
            <img
              src={thumbnail.src}
              srcset={thumbnail.srcset}
              sizes={thumbnail.sizes}
              width={thumbnail.width}
              height={thumbnail.height}
              alt={photo.alt}
              loading={hint.loading}
              fetchpriority={hint.fetchpriority}
              decoding="async"
            />
          </button>
          <button type="button" class="check" aria-pressed="false" aria-label={`Select: ${photo.alt}`} data-select>
            <span class="check-mark"><CheckIcon size={14} /></span>
          </button>
        </li>
      );
    })
  }
</ul>
<script is:inline type="application/json" id="viewer-data" set:html={jsonForScript(viewerData)} />
<SelectionBar />
<PostViewer />

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--grid-gap);
    /* Edge to edge on phones. */
    margin-inline: calc(-1 * var(--gutter));
  }

  /*
   * A row's shares add up to 1. The basis leaves room for the gaps (so a row never wraps
   * early) and growing by share hands the last few pixels back, so the row ends exactly at
   * the grid's edge. The cap keeps a lone short row from growing (justified-grid.ts).
   */
  .grid > li {
    --share: var(--share-phone);
    position: relative;
    flex: var(--share) 1 calc(var(--share) * 100% - var(--grid-gap));
    min-width: 0;
    max-width: calc(var(--share) * 100%);
    aspect-ratio: var(--aspect);
  }

  @media (min-width: 600px) {
    .grid {
      margin-inline: 0;
    }

    .grid > li {
      --share: var(--share-tablet);
    }
  }

  @media (min-width: 1100px) {
    .grid > li {
      --share: var(--share-desktop);
    }
  }

  .tile {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--color-surface-sunken);
    cursor: pointer;
    overflow: hidden;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* A selected photo draws in from the tile's edges, on the sunken surface. */
  .is-selected .tile img {
    transform: scale(0.88);
  }

  /* Tap-and-hold selects: no "Save image" callout or text selection in its way. */
  .grid[data-selectable] .tile,
  .grid[data-selectable] .tile img {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* ---------- Check circle ---------- */

  .check {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-on-photo);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .grid[data-selectable] .check {
    display: grid;
  }

  .check-mark {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    background: var(--color-viewer-control);
    box-shadow: inset 0 0 0 2px var(--color-on-photo-muted);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  /* Shown while selecting, on keyboard focus, and on hover where there is a mouse. */
  .grid[data-selecting] .check,
  .tile:focus-visible + .check,
  .check:focus-visible {
    opacity: 1;
  }

  /* An invisible circle must not catch taps meant to open the photo. */
  .grid:not([data-selecting]) .check {
    pointer-events: none;
  }

  @media (hover: hover) {
    .grid > li:hover .check {
      opacity: 1;
      pointer-events: auto;
    }

    .check:hover .check-mark {
      background: var(--color-viewer-control-hover);
    }
  }

  /* While selecting, an unselected photo has an empty circle. */
  .grid[data-selecting] li:not(.is-selected) .check:not(:focus-visible) :global(svg) {
    opacity: 0;
  }

  @media (hover: hover) {
    .grid[data-selecting] li:not(.is-selected) .check:hover :global(svg) {
      opacity: 1;
    }
  }

  .is-selected .check-mark,
  .is-selected .check:hover .check-mark {
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 0 2px var(--color-on-accent);
  }

  .check:focus-visible {
    outline: none;
  }

  .check:focus-visible .check-mark {
    outline: 2px solid var(--color-viewer-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--color-viewer-bg);
  }

  /* Hover veil and focus ring sit above the photo. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background-color var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }

  /* Only with a mouse: on a phone, :hover sticks to the last tile tapped. */
  @media (hover: hover) {
    .tile:hover::after {
      background: var(--color-tile-veil);
    }
  }

  .tile:focus-visible {
    outline: none;
  }

  .tile:focus-visible::after {
    border: 3px solid var(--color-focus);
    box-shadow: inset 0 0 0 2px var(--color-bg);
  }
</style>
