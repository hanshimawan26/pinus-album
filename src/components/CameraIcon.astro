---
/** Outline camera, drawn at a 1.5px stroke; marks a photographer credit (PhotoCredit). Decorative. */
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---

<svg class="camera-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M3.75 8.75a2 2 0 0 1 2-2h2.1l1.4-2h5.5l1.4 2h2.1a2 2 0 0 1 2 2v9.5a2 2 0 0 1-2 2H5.75a2 2 0 0 1-2-2Z"></path>
  <circle cx="12" cy="13.25" r="3.5"></circle>
</svg>

<style>
  .camera-icon {
    flex: none;
  }
  path,
  circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
