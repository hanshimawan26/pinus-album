---
/** Outline "photo" pictogram for empty covers and empty states; decorative. */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg class="image-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect>
  <circle cx="8.75" cy="9.75" r="1.75"></circle>
  <path d="m3.5 17 5.25-5 4 3.75 2.75-2.5L21 18"></path>
</svg>

<style>
  .image-icon {
    flex: none;
  }
  rect,
  circle,
  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
