---
/**
 * The association's logo, `public/logo.svg`, shown at `size` px. On the dark theme it sits on
 * a white rounded rectangle (`--color-logo-plate`, `--logo-plate-inset`), because its navy
 * ring disappears on the dark page; on the light theme the plate is invisible. The
 * browser-tab icon is a separate file, `public/favicon.svg` (the logo on a white disc).
 * To change the logo, replace both; keep them square-ish. Decorative: the site title next to
 * it names the link, so `alt` is empty.
 */
import { withBase } from '../lib/url.ts';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img class="mark" src={withBase('logo.svg')} width={size} height={size} alt="" decoding="async" />

<style>
  /* The plate is the image's own padding and background, so the logo needs no wrapper. */
  .mark {
    flex: none;
    display: block;
    box-sizing: border-box;
    padding: var(--logo-plate-inset);
    border-radius: var(--radius-sm);
    background: var(--color-logo-plate);
    object-fit: contain;
  }
</style>
