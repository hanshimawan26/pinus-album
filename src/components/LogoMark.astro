---
/**
 * The association's logo, `public/logo.svg` (also the browser-tab icon, see BaseLayout).
 * To change the logo, replace that file; keep it square-ish, the header shows it at
 * `size` px. Decorative: the site title next to it names the link, so `alt` is empty.
 */
import { withBase } from '../lib/url.ts';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img class="mark" src={withBase('logo.svg')} width={size} height={size} alt="" decoding="async" />

<style>
  .mark {
    flex: none;
    display: block;
    object-fit: contain;
  }
</style>
