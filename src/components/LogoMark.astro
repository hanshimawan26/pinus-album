---
/**
 * The association's logo, `public/logo.svg`. The browser-tab icon is a separate file,
 * `public/favicon.svg` (the logo on a white disc; see BaseLayout). In the dark theme the
 * header shows favicon.svg too, because the logo's navy ring disappears on the dark page.
 * To change the logo, replace both; keep them square-ish, the header shows them at `size` px.
 * Decorative: the site title next to it names the link, so `alt` is empty.
 */
import { withBase } from '../lib/url.ts';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<picture>
  <source srcset={withBase('favicon.svg')} media="(prefers-color-scheme: dark)" />
  <img class="mark" src={withBase('logo.svg')} width={size} height={size} alt="" decoding="async" />
</picture>

<style>
  picture {
    display: contents;
  }

  .mark {
    flex: none;
    display: block;
    object-fit: contain;
  }
</style>
