---
/**
 * Placeholder mark until the association supplies a logo (PRODUCT.md): a "P" monogram on
 * brand blue with a yellow full stop. Decorative: the site title next to it names the link.
 * The same drawing is public/favicon.svg.
 */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 36 36" aria-hidden="true" focusable="false">
  <rect class="ground" width="36" height="36" rx="9"></rect>
  <path class="letter" fill-rule="evenodd" d="M11 8h7.5a6.5 6.5 0 0 1 0 13H15v7h-4zm4 4v5h3.5a2.5 2.5 0 0 0 0-5z"></path>
  <circle class="dot" cx="27" cy="26" r="2.75"></circle>
</svg>

<style>
  .mark {
    flex: none;
    display: block;
  }
  .ground {
    fill: var(--brand-blue);
  }
  .letter {
    fill: var(--color-on-accent);
  }
  .dot {
    fill: var(--brand-yellow);
  }
</style>
