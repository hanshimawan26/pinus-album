---
/**
 * Grid of event cards (home) or section cards (album page).
 * Events: 1 column, 2 from 600px, 3 from 900px. Sections: 2 columns, 3 from 900px,
 * 4 from 1100px. Keep in step with `coverSizes()` in src/lib/image-sizes.ts.
 */
import type { AlbumNode } from '../lib/content/types.ts';
import { loadingHint, type CardSize } from '../lib/image-sizes.ts';
import AlbumCard from './AlbumCard.astro';

interface Props {
  nodes: readonly AlbumNode[];
  size: CardSize;
  headingLevel: 2 | 3;
  /** True when the list starts in the first viewport, so the first row loads eagerly. */
  nearTop: boolean;
}

const { nodes, size, headingLevel, nearTop } = Astro.props;
// High priority: the first row on a phone (1 event card, 2 section cards). Eager: what is in
// the first viewport of a phone (2 event cards stacked; 2 rows of section cards). On wider
// screens the rest of the first row is lazy but in view, so it still loads at once.
const policy = size === 'event' ? { nearTop, highPriority: 1, eager: 2 } : { nearTop, highPriority: 2, eager: 4 };
---

<ul class:list={['bare-list', 'cards', `cards--${size}`]} role="list">
  {
    nodes.map((node, index) => (
      <li>
        <AlbumCard node={node} size={size} headingLevel={headingLevel} loading={loadingHint(index, policy)} />
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: var(--space-6) var(--space-5);
  }

  .cards--event {
    grid-template-columns: minmax(0, 1fr);
  }

  .cards--section {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-3);
  }

  @media (min-width: 600px) {
    .cards--event {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards--section {
      gap: var(--space-6) var(--space-4);
    }
  }

  @media (min-width: 900px) {
    .cards--event,
    .cards--section {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .cards--section {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
