---
/** A friendly note where there is nothing to show yet (no events, an empty album, 404). */
import ImageIcon from './ImageIcon.astro';

interface Props {
  title: string;
  /** Heading level inside the page outline. An h1 takes the shared page-title style. */
  headingLevel?: 1 | 2;
}
const { title, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---

<section class="empty">
  <ImageIcon size={40} />
  <Heading class:list={['title', { 'page-title': headingLevel === 1 }]}>{title}</Heading>
  <div class="body"><slot /></div>
</section>

<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    text-align: center;
  }

  .title {
    color: var(--color-text);
  }

  .title:not(.page-title) {
    font-size: var(--text-lg);
    font-weight: 650;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 42ch;
  }
</style>
