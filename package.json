{
  "name": "pinus-album",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Pinus Community digital photo album (static Astro site for GitHub Pages)",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
